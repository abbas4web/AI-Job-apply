// ─────────────────────────────────────────────────────────────
// Prisma Schema — AI Job Apply
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum ApplicationStatus {
  SAVED           // user bookmarked the job
  MATCHED         // AI matched, not yet reviewed
  READY_TO_APPLY  // user decided to apply
  APPLIED         // application submitted
  INTERVIEW       // interview scheduled
  OFFER           // offer received
  REJECTED        // rejected by employer or withdrawn
}

enum JobSource {
  LINKEDIN
  INDEED
  GLASSDOOR
  COMPANY_SITE
  REFERRAL
  OTHER
}

enum ScrapingStatus {
  STARTED
  SUCCESS
  FAILED
}

enum JobMatchStatus {
  PENDING    // enqueued, not yet processed
  PROCESSING // worker picked it up
  COMPLETED  // Gemini returned a result
  FAILED     // all retries exhausted
}

enum EmailStatus {
  PENDING   // queued, not yet attempted
  SENT      // provider accepted the message
  FAILED    // all retries exhausted
}

// ── Models ────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resumes      Resume[]
  applications Application[]
  scrapingLogs ScrapingLog[]
  matchResults JobMatchResult[]
  emailLogs    EmailLog[]
  automationSettings UserAutomationSettings?

  @@map("users")
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  profile      ResumeProfile?
  matchResults JobMatchResult[]

  @@map("resumes")
}

// Stores the structured AI analysis result for a resume (1-to-1)
model ResumeProfile {
  id                String   @id @default(cuid())
  resumeId          String   @unique
  summary           String   @db.Text
  skills            String[] // PostgreSQL array
  yearsOfExperience Float
  jobTitles         String[]
  technologies      String[]
  // Education is stored as JSON (array of objects)
  education         Json
  analyzedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_profiles")
}

model Job {
  id          String    @id @default(cuid())
  title       String
  company     String
  location    String
  description String    @db.Text
  skills      String[]
  source      JobSource
  sourceUrl   String
  externalId  String?
  salary      String?
  postedAt    DateTime?
  isDuplicate Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications Application[]
  matchResults JobMatchResult[]

  // Prevent duplicate ingestion from the same source
  @@unique([source, externalId])
  @@map("jobs")
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  jobId       String
  resumeId    String?
  status      ApplicationStatus @default(SAVED)
  matchScore  Int?              // 0–100 from Gemini; null if not yet matched
  notes       String?           @db.Text
  appliedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user   User    @relation(fields: [userId],   references: [id], onDelete: Cascade)
  job    Job     @relation(fields: [jobId],     references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id])

  // One application per user per job
  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("applications")
}

model ScrapingLog {
  id        String         @id @default(cuid())
  userId    String
  source    JobSource
  query     String
  location  String?
  status    ScrapingStatus @default(STARTED)
  jobsFound Int            @default(0)
  error     String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scraping_logs")
}

// ── JobMatchResult ─────────────────────────────────────────────
// Stores the Gemini match assessment for a (user, job, resume) triple.
//
// Unique constraint on (userId, jobId, resumeId) means:
//   - prisma.jobMatchResult.upsert() is safe to call on every retry
//     without creating duplicate rows.
//   - Re-running the worker for the same job simply overwrites the
//     previous result with the latest Gemini output.

model JobMatchResult {
  id               String         @id @default(cuid())
  userId           String
  jobId            String
  resumeId         String

  // ── Match signal from Gemini ──────────────────────────────
  status           JobMatchStatus @default(PENDING)
  matchScore       Int?           // 0–100; null until COMPLETED
  matchedSkills    String[]
  missingSkills    String[]
  experienceMatch  Boolean?
  locationMatch    Boolean?
  reason           String?        @db.Text

  // ── Metadata ──────────────────────────────────────────────
  /// BullMQ job ID — lets us correlate queue jobs with DB rows
  queueJobId       String?
  errorMessage     String?        @db.Text
  processedAt      DateTime?      // set when status → COMPLETED
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user   User   @relation(fields: [userId],   references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId],     references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  // One result per (user, job, resume) triple — makes upsert idempotent
  @@unique([userId, jobId, resumeId])
  @@index([userId])
  @@index([jobId])
  @@map("job_match_results")
}

// ── EmailLog ───────────────────────────────────────────────────
// One record per send attempt.  Multiple rows per application are
// possible (initial send + retries all create rows).
// The latest row with status=SENT is the authoritative record.

model EmailLog {
  id            String      @id @default(cuid())
  userId        String
  applicationId String

  status        EmailStatus @default(PENDING)

  // ── Message details ───────────────────────────────────────
  recipientEmail String
  subject        String
  /// Provider message-ID returned on success (e.g. SMTP messageId)
  providerMsgId  String?

  // ── Failure details ───────────────────────────────────────
  errorMessage   String?     @db.Text

  // ── Queue correlation ─────────────────────────────────────
  queueJobId     String?

  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@map("email_logs")
}

// ── UserAutomationSettings ─────────────────────────────────────
// One row per user (1-to-1). Created on first GET with safe defaults.
// autoApplyEnabled is a stored preference only — the backend reads
// this flag when deciding whether to trigger actions, but no
// applications are sent automatically yet.

model UserAutomationSettings {
  id     String @id @default(cuid())
  userId String @unique

  // ── Match threshold ───────────────────────────────────────
  /// Minimum Gemini matchScore (0–100) required before considering a job
  minimumMatchScore  Int      @default(70)

  // ── Job preferences ───────────────────────────────────────
  /// Job titles the user is interested in (e.g. ["Senior Engineer", "Tech Lead"])
  preferredJobTitles String[] @default([])

  /// Locations the user will accept (e.g. ["Remote", "Berlin"])
  preferredLocations String[] @default([])

  /// Skills the job must advertise (AND filter)
  requiredSkills     String[] @default([])

  /// Companies to skip entirely
  excludedCompanies  String[] @default([])

  // ── Automation gate ───────────────────────────────────────
  /// Master switch — when false the backend never triggers automatic sends
  autoApplyEnabled   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_automation_settings")
}
