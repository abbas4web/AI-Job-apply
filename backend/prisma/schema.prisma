// ─────────────────────────────────────────────────────────────
// Prisma Schema — AI Job Apply
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPLYING
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
}

enum JobSource {
  LINKEDIN
  INDEED
  GLASSDOOR
  COMPANY_SITE
  REFERRAL
  OTHER
}

enum ScrapingStatus {
  STARTED
  SUCCESS
  FAILED
}

enum JobMatchStatus {
  PENDING    // enqueued, not yet processed
  PROCESSING // worker picked it up
  COMPLETED  // Gemini returned a result
  FAILED     // all retries exhausted
}

// ── Models ────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resumes      Resume[]
  applications Application[]
  scrapingLogs ScrapingLog[]
  matchResults JobMatchResult[]

  @@map("users")
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  profile      ResumeProfile?
  matchResults JobMatchResult[]

  @@map("resumes")
}

// Stores the structured AI analysis result for a resume (1-to-1)
model ResumeProfile {
  id                String   @id @default(cuid())
  resumeId          String   @unique
  summary           String   @db.Text
  skills            String[] // PostgreSQL array
  yearsOfExperience Float
  jobTitles         String[]
  technologies      String[]
  // Education is stored as JSON (array of objects)
  education         Json
  analyzedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_profiles")
}

model Job {
  id          String    @id @default(cuid())
  title       String
  company     String
  location    String
  description String    @db.Text
  skills      String[]
  source      JobSource
  sourceUrl   String
  externalId  String?
  salary      String?
  postedAt    DateTime?
  isDuplicate Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications Application[]
  matchResults JobMatchResult[]

  // Prevent duplicate ingestion from the same source
  @@unique([source, externalId])
  @@map("jobs")
}

model Application {
  id             String            @id @default(cuid())
  userId         String
  jobId          String
  resumeId       String?
  status         ApplicationStatus @default(PENDING)
  coverLetter    String?           @db.Text
  tailoredResume String?           @db.Text
  notes          String?           @db.Text
  appliedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id])

  @@map("applications")
}

model ScrapingLog {
  id        String         @id @default(cuid())
  userId    String
  source    JobSource
  query     String
  location  String?
  status    ScrapingStatus @default(STARTED)
  jobsFound Int            @default(0)
  error     String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scraping_logs")
}

// ── JobMatchResult ─────────────────────────────────────────────
// Stores the Gemini match assessment for a (user, job, resume) triple.
//
// Unique constraint on (userId, jobId, resumeId) means:
//   - prisma.jobMatchResult.upsert() is safe to call on every retry
//     without creating duplicate rows.
//   - Re-running the worker for the same job simply overwrites the
//     previous result with the latest Gemini output.

model JobMatchResult {
  id               String         @id @default(cuid())
  userId           String
  jobId            String
  resumeId         String

  // ── Match signal from Gemini ──────────────────────────────
  status           JobMatchStatus @default(PENDING)
  matchScore       Int?           // 0–100; null until COMPLETED
  matchedSkills    String[]
  missingSkills    String[]
  experienceMatch  Boolean?
  locationMatch    Boolean?
  reason           String?        @db.Text

  // ── Metadata ──────────────────────────────────────────────
  /// BullMQ job ID — lets us correlate queue jobs with DB rows
  queueJobId       String?
  errorMessage     String?        @db.Text
  processedAt      DateTime?      // set when status → COMPLETED
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user   User   @relation(fields: [userId],   references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId],     references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  // One result per (user, job, resume) triple — makes upsert idempotent
  @@unique([userId, jobId, resumeId])
  @@index([userId])
  @@index([jobId])
  @@map("job_match_results")
}
